# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://lionheartscholars.org

# Stripe (apply for nonprofit pricing; enable Apple Pay / Google Pay; PayPal where available)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Claude (document reading, review drafts, help assistant)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email
RESEND_API_KEY=
EMAIL_FROM=Lionheart <hello@lionheartscholars.org>

# Organization
SGO_EIN=00-0000000
SGO_LEGAL_NAME=Lionheart Scholarship Granting Organization, Inc.

# Outbound ACH to schools: manual (CSV for bank portal) | increase
PAYOUT_PROVIDER=manual
INCREASE_API_KEY=
INCREASE_SEGREGATED_ACCOUNT_ID=

# Credit rules
CREDIT_ELIGIBLE_FROM=2027-01-01
# Flip to true once Lionheart appears on the IRS SGO list; scheduled pledges then charge.
SGO_LISTED=false

# Trigger.dev (scheduled jobs)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Google Maps JavaScript API browser key (restrict to your site domain). Optional: without it the schools map uses OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
